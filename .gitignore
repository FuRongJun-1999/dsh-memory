node_modules/
/lib/
*.tsbuildinfo

# CodeBuddy 本地配置与计划（不入库）
/.codebuddy/

# AGENTS.md 本地使用（CodeBuddy 会话起始注入，不共享）
/AGENTS.md

# md_cg 运行时数据（含 _keys.json 密钥，绝不入库）
/data/mdcg/

# 自举循环运行态数据（持续增长的日志/队列/草稿；仅本地留存，不入库）
/data/bootstrap/

# 历史遗留参考文件（防 git add -A 误提交，issue#8 修复时曾污染 360 文件）
/awesome*
/wf_*.yml
/dsh-bridge_*
/build-site.mjs
/check-submission.mjs
/site_locales.mjs
/scripts_lib_entries.mjs

# llm-adapter-poc：AI 实验工作区（非公开内容，仅本地保留）
# 约 12k 实验产物文件 + venv + 本地大 db；与插件源码/发布产物无关
llm-adapter-poc/

# md_cg 运行时数据与产物（可重跑 migrate 再生，不入库）
/_md_cg_p*/
/_md_cg_membench/
/_md_cg_eval_*/
/wisdom-book-cloud-new.db
/md_cg/__pycache__/
/scripts/__pycache__/

# 白箱自举/图谱迁移的运行时产物（可由脚本重跑再生，不入库）
/_md_cg_wisdom_graph/
/data/verify_cache.json
/data/vision/

# 他项目遗留参考文件与旧打包产物（非本仓库内容，防 git add -A 误提交）
/dsh-bridge-readme.md
/generate-readme.mjs
/lingshu_entry.yml
/*.tgz

# 白箱知识库（md_cg/whitebox_kb）：真源为 *.py 与 *.md；
# 下列为编译产物 / 可再生索引 / SQLite 运行态，不入库
/md_cg/whitebox_kb/**/__pycache__/
*.pyc
*.pyo
/md_cg/whitebox_kb/**/*.npz
/md_cg/whitebox_kb/**/*.db
/md_cg/whitebox_kb/**/*.db-shm
/md_cg/whitebox_kb/**/*.db-wal
/md_cg/whitebox_kb/**/neural_index.json
/md_cg/whitebox_kb/knowledge/_ccg_dump.json
/md_cg/whitebox_kb/knowledge/_index.json
/md_cg/whitebox_kb/data/

# 灵枢运行时 sqlite（db/shm/wal；运行时产物，不入库）
/data/lingshu.db
/data/lingshu.db-shm
/data/lingshu.db-wal
# 灵枢路径配置（本地绝对路径，不入公开仓）
/data/paths.json

# 公开基准数据集本地派生副本（大 JSON，不入库；对外发布的成品见 data/benchmarks/）
/data/external/
# IDE 本地配置（不共享）
/.vscode/
# 白箱链条热度为运行时计数日志（可重跑再生），不入库
/md_cg/whitebox_kb/wisdom/audit_log/chain_heat.json

# Rust 评测器（mdcg-eval）构建产物（cargo build --release 可再生；
# 且 .d/.fingerprint 含本地绝对路径，绝不入公开仓）
/rust/target/

# 实验工作区（docs/experiments）：实验脚本 / result_*.json / _store 数据目录
# 均为本地实验产物，不入库（_store 含 _index.json 与 *.lock，可由同目录
# run_*.py 重跑再生；实验结论沉淀在 docs/ 的评测报告 md 中）
docs/experiments/
