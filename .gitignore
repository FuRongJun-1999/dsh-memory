llm-adapter-poc/

# md_cg 运行时数据与产物（可重跑 migrate 再生，不入库）
/_md_cg_p*/
/_md_cg_membench/
/_md_cg_eval_*/
/wisdom-book-cloud-new.db
/md_cg/__pycache__/
/scripts/__pycache__/

# 白箱自举/图谱迁移的运行时产物（可由脚本重跑再生，不入库）
/_md_cg_wisdom_graph/
/data/verify_cache.json
/data/vision/

# 他项目遗留参考文件与旧打包产物（非本仓库内容，防 git add -A 误提交）
/dsh-bridge-readme.md
/generate-readme.mjs
/lingshu_entry.yml
/*.tgz

# 白箱知识库（md_cg/whitebox_kb）：真源为 *.py 与 *.md；
# 下列为编译产物 / 可再生索引 / SQLite 运行态，不入库
/md_cg/whitebox_kb/**/__pycache__/
*.pyc
*.pyo
/md_cg/whitebox_kb/**/*.npz
/md_cg/whitebox_kb/**/*.db
/md_cg/whitebox_kb/**/*.db-shm
/md_cg/whitebox_kb/**/*.db-wal
/md_cg/whitebox_kb/**/neural_index.json
/md_cg/whitebox_kb/knowledge/_ccg_dump.json
/md_cg/whitebox_kb/knowledge/_index.json
/md_cg/whitebox_kb/data/

# 灵枢运行时 sqlite（db/shm/wal；运行时产物，不入库）
/data/lingshu.db
/data/lingshu.db-shm
/data/lingshu.db-wal
# 灵枢路径配置（本地绝对路径，不入公开仓）
/data/paths.json

# 公开基准数据集本地派生副本（大 JSON，不入库；对外发布的成品见 data/benchmarks/）
/data/external/
# IDE 本地配置（不共享）
/.vscode/
# 白箱链条热度为运行时计数日志（可重跑再生），不入库
/md_cg/whitebox_kb/wisdom/audit_log/chain_heat.json

# Rust 评测器（mdcg-eval）构建产物（cargo build --release 可再生；
# 且 .d/.fingerprint 含本地绝对路径，绝不入公开仓）
/rust/target/
# Rust 评测一次性 dump 与结果输出（可重跑再生）
/rust/loco_*

# md_cg 下的评测灌库（可由 data/benchmarks/ 重灌再生；根目录规则 /_md_cg_eval_*/
# 因路径锚定不覆盖 md_cg/ 子目录实例）与 mdcg 审计日志（运行时追加，不入库）
/md_cg/_md_cg_eval_*/
/md_cg/_audit.jsonl
/md_cg/knowledge/

# md_cg 密钥签发产物（tokens issue 落盘；密钥绝不入库）
/md_cg/_keys.json

# 蜂群 rust 运行时构建产物（cargo build 可再生；fingerprint 含本地绝对路径）
/swarm/rust_runtime/target/

# 蜂巢并发引擎运行时（jobs 任务目录为运行态数据；target 为 cargo 构建产物，
# 且 .d/.fingerprint 含本地绝对路径——均不入公开仓）
/hive/jobs/
/hive/target/
# 蜂巢工作记忆仓（任务产物版本化运行态；wm-repo 为 git 仓本体，不入公开仓）
/hive/wm-repo/
/hive/plans/naming_gov/specs/
# 蜂巢 serve 本地环境配置（引用系统变量/个人数据文件路径，不入公开仓）
/hive/config.local.json
# 蜂巢互验**迭代交割面**（hive/interop/iter-*）：每轮投放/认领的中间产物目录
# （request / proposals / replay / 回执副本），随轮次线性增长——v14 报告 I：
# 2159 文件 / 8.7MB 入库且未忽略，属「迭代中间产物进仓」。协议**真源**仍是
# 顶层台账与索引（_receipts_ledger.tsv / _dispatch_ledger.tsv /
# _offers_index.md / note-*.md），据其可从对应 commit 重放再生交割面，
# 故迭代目录不入库、仅本地留存。
/hive/interop/iter-*/

# 实验工作区（docs/experiments）：实验脚本 / result_*.json / _store 数据目录
# 均为本地实验产物，不入库（_store 含 _index.json 与 *.lock，可由同目录
# run_*.py 重跑再生；实验结论沉淀在 docs/ 的评测报告 md 中）
docs/experiments/
