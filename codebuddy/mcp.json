{
  "mcpServers": {
    "mdcg": {
      "command": "python",
      "args": ["-m", "md_cg.mcp_server"],
      "env": {
        "PYTHONPATH": "REPLACE_WITH_ABSOLUTE_PATH_TO_dsh-memory",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "MDCG_MCP_SURFACE": "kernel",
        "MDCG_ACTOR": "codebuddy",
        "MDCG_TENANT": "default",
        "MDCG_CLEARANCE": "private",
        "MDCG_TOKEN": ""
      }
    },
    "hive": {
      "command": "python",
      "args": ["-m", "hive.hive_mcp.mcp_server"],
      "env": {
        "PYTHONPATH": "REPLACE_WITH_ABSOLUTE_PATH_TO_dsh-memory",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
